local function getRarityColor(rarity)
    local r = string.lower(tostring(rarity))
    if string.find(r, "sovereign") or string.find(r, "mythic") or string.find(r, "secret") then
        return 16711680
    elseif string.find(r, "legendary") then
        return 16766720
    elseif string.find(r, "epic") then
        return 10181046
    elseif string.find(r, "rare") then
        return 3447003
    else
        return 9807270
    end
end

-- Hàm dò khu vực hiện tại từ UI trên màn hình hoặc vị trí nhân vật
local function detectCurrentArea()
    -- 1. Kiểm tra Attributes của Player
    for k, v in pairs(LocalPlayer:GetAttributes()) do
        local kl = string.lower(k)
        if string.find(kl, "area") or string.find(kl, "zone") or string.find(kl, "biome") or string.find(kl, "world") or string.find(kl, "region") then
            if tostring(v) ~= "" then return tostring(v) end
        end
    end

    -- 2. Quét trong PlayerGui xem có nhãn (TextLabel) nào hiển thị tên khu vực không
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        for _, guiObj in ipairs(pGui:GetDescendants()) do
            if guiObj:IsA("TextLabel") and guiObj.Visible and guiObj.Text ~= "" then
                local n = string.lower(guiObj.Name)
                if string.find(n, "area") or string.find(n, "zone") or string.find(n, "biome") or string.find(n, "location") then
                    return guiObj.Text
                end
            end
        end
    end

    -- 3. Kiểm tra xem nhân vật đang đứng trong vùng Part/Folder nào trong Workspace
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, folderName in ipairs({"Zones", "Areas", "Biomes", "Maps", "Regions"}) do
            local zoneFolder = workspace:FindFirstChild(folderName)
            if zoneFolder then
                for _, zone in ipairs(zoneFolder:GetChildren()) do
                    if zone:IsA("BasePart") then
                        local dist = (hrp.Position - zone.Position).Magnitude
                        if dist <= (zone.Size.Magnitude / 2) then
                            return zone.Name
                        end
                    end
                end
            end
        end
    end

    return "Không rõ"
end

local function extractPetInfo(item)
    local info = {
        Name = item.Name,
        Weight = "Không rõ",
        Rarity = "Thường (Common)",
        Value = "Không rõ",
        Area = "Không rõ",
        ExtraDump = {} -- Lưu lại toàn bộ các chỉ số khác tìm thấy trong item
    }

    -- Quét tất cả Attributes trong item
    for key, val in pairs(item:GetAttributes()) do
        local k = string.lower(key)
        local vStr = tostring(val)
        table.insert(info.ExtraDump, key .. ": " .. vStr)

        if string.find(k, "weight") or string.find(k, "kg") or string.find(k, "mass") or string.find(k, "size") then
            info.Weight = vStr
        elseif string.find(k, "rarity") or string.find(k, "tier") or string.find(k, "grade") then
            info.Rarity = vStr
        elseif string.find(k, "value") or string.find(k, "price") or string.find(k, "worth") or string.find(k, "money") or string.find(k, "cash") or string.find(k, "coin") or string.find(k, "sell") or string.find(k, "earn") or string.find(k, "income") then
            info.Value = vStr
        elseif string.find(k, "area") or string.find(k, "zone") or string.find(k, "biome") or string.find(k, "world") then
            info.Area = vStr
        end
    end

    -- Quét tất cả ValueBase và TextLabel con bên trong item (bao gồm ToolTip/BillboardGui gắn trên thú)
    for _, child in ipairs(item:GetDescendants()) do
        local k = string.lower(child.Name)
        local vStr = nil
        if child:IsA("ValueBase") then
            vStr = tostring(child.Value)
            table.insert(info.ExtraDump, child.Name .. ": " .. vStr)
        elseif child:IsA("TextLabel") and child.Text ~= "" then
            vStr = child.Text
            if string.find(vStr, "%$") or string.find(string.lower(vStr), "coin") or string.find(string.lower(vStr), "/s") then
                if info.Value == "Không rõ" then info.Value = vStr end
            end
        end

        if vStr then
            if (string.find(k, "weight") or string.find(k, "kg")) and info.Weight == "Không rõ" then info.Weight = vStr end
            if (string.find(k, "rarity") or string.find(k, "tier")) and info.Rarity == "Thường (Common)" then info.Rarity = vStr end
            if (string.find(k, "value") or string.find(k, "price") or string.find(k, "worth") or string.find(k, "money") or string.find(k, "cash") or string.find(k, "sell") or string.find(k, "earn")) and info.Value == "Không rõ" then info.Value = vStr end
            if (string.find(k, "area") or string.find(k, "zone") or string.find(k, "biome")) and info.Area == "Không rõ" then info.Area = vStr end
        end
    end

    -- Nếu item không ghi khu vực, tự dò khu vực hiện tại của nhân vật
    if info.Area == "Không rõ" then
        info.Area = detectCurrentArea()
    end

    return info
end

local function sendDiscordWebhook(petData)
    if not isRunning then return end
    petsCaughtCount = petsCaughtCount + 1

    local playerName = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName
    local userId = tostring(LocalPlayer.UserId)
    local profileLink = "https://www.roblox.com/users/" .. userId .. "/profile"
    local avatarThumb = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. userId .. "&width=420&height=420&format=png"

    -- Gom các chỉ số phụ tìm thấy (nếu game đặt tên biến lạ thì nó sẽ hiện hết ở đây)
    local rawDetails = #petData.ExtraDump > 0 and table.concat(petData.ExtraDump, " | ") or "Không có thuộc tính ẩn"

    local payload = {
        ["content"] = "<@" .. DiscordUserID .. "> 🎉 Bạn vừa bắt được một sinh vật mới!",
        ["embeds"] = {{
            ["title"] = "🐾 BẮT ĐƯỢC THÚ MỚI: " .. petData.Name,
            ["color"] = getRarityColor(petData.Rarity),
            ["thumbnail"] = { ["url"] = avatarThumb },
            ["fields"] = {
                { ["name"] = "✨ Độ hiếm", ["value"] = "`" .. petData.Rarity .. "`", ["inline"] = true },
                { ["name"] = "⚖️ Cân nặng", ["value"] = "`" .. petData.Weight .. "`", ["inline"] = true },
                { ["name"] = "💰 Giá trị / Tiền", ["value"] = "`" .. petData.Value .. "`", ["inline"] = true },
                { ["name"] = "🗺️ Khu vực", ["value"] = "`" .. petData.Area .. "`", ["inline"] = true },
                { ["name"] = "📊 Dữ liệu gốc (Raw Stats)", ["value"] = "```" .. rawDetails .. "```", ["inline"] = false },
                { ["name"] = "👤 Nhân vật Roblox", ["value"] = string.format("[%s (@%s)](%s)\n**ID:** `%s`", displayName, playerName, profileLink, userId), ["inline"] = false }
            },
            ["footer"] = { ["text"] = "Throw Food For Animals • Auto Logger" },
            ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    pcall(function()
        httpRequest({
            Url = WebhookURL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload)
        })
    end)
end

