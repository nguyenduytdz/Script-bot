local function monitorContainer(container)
    if not container then return end
    container.ChildAdded:Connect(function(newItem)
        if not isRunning then return end
        task.wait(0.4)
        local itemNameLower = string.lower(newItem.Name)
        if string.find(itemNameLower, "food") or string.find(itemNameLower, "bait") then
            if not newItem:GetAttribute("Weight") and not newItem:GetAttribute("Rarity") then
                return
            end
        end
        local petInfo = extractPetInfo(newItem)
        sendDiscordWebhook(petInfo)
    end)
end

