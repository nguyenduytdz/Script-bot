local function getRarityColor(rarity)
    local r = string.lower(tostring(rarity))
    if string.find(r, "sovereign") or string.find(r, "mythic") or string.find(r, "secret") then
        return 16711680
    elseif string.find(r, "legendary") then
        return 16766720
    elseif string.find(r, "epic") then
        return 10181046
    elseif string.find(r, "rare") then
        return 3447003
    else
        return 9807270
    end
end

local function extractPetInfo(item)
    local info = {
        Name = item.Name,
        Weight = "Không rõ",
        Rarity = "Thường (Common)",
        Value = "Không rõ",
        Area = "Không rõ"
    }

    local attributes = item:GetAttributes()
    for key, val in pairs(attributes) do
        local k = string.lower(key)
        if string.find(k, "weight") or string.find(k, "kg") or string.find(k, "mass") then
            info.Weight = tostring(val)
        elseif string.find(k, "rarity") or string.find(k, "tier") then
            info.Rarity = tostring(val)
        elseif string.find(k, "value") or string.find(k, "price") or string.find(k, "worth") or string.find(k, "money") then
            info.Value = tostring(val)
        elseif string.find(k, "area") or string.find(k, "zone") or string.find(k, "biome") then
            info.Area = tostring(val)
        end
    end

    for _, child in ipairs(item:GetDescendants()) do
        local k = string.lower(child.Name)
        local valStr = child:IsA("ValueBase") and tostring(child.Value) or nil
        if valStr then
            if (string.find(k, "weight") or string.find(k, "kg")) and info.Weight == "Không rõ" then info.Weight = valStr end
            if (string.find(k, "rarity") or string.find(k, "tier")) and info.Rarity == "Thường (Common)" then info.Rarity = valStr end
            if (string.find(k, "value") or string.find(k, "price") or string.find(k, "worth")) and info.Value == "Không rõ" then info.Value = valStr end
            if (string.find(k, "area") or string.find(k, "zone")) and info.Area == "Không rõ" then info.Area = valStr end
        end
    end

    if info.Area == "Không rõ" then
        for _, attrName in ipairs({"CurrentArea", "Zone", "Area", "Biome"}) do
            local zoneVal = LocalPlayer:GetAttribute(attrName)
            if zoneVal then info.Area = tostring(zoneVal) break end
        end
    end

    return info
end

local function sendDiscordWebhook(petData)
    if not isRunning then return end
    petsCaughtCount = petsCaughtCount + 1

    local playerName = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName
    local userId = tostring(LocalPlayer.UserId)
    local profileLink = "https://www.roblox.com/users/" .. userId .. "/profile"
    local avatarThumb = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. userId .. "&width=420&height=420&format=png"

    local payload = {
        ["content"] = "<@" .. DiscordUserID .. "> 🎉 Bạn vừa bắt được một sinh vật mới!",
        ["embeds"] = {{
            ["title"] = "🐾 BẮT ĐƯỢC THÚ MỚI: " .. petData.Name,
            ["color"] = getRarityColor(petData.Rarity),
            ["thumbnail"] = { ["url"] = avatarThumb },
            ["fields"] = {
                { ["name"] = "✨ Độ hiếm", ["value"] = "`" .. petData.Rarity .. "`", ["inline"] = true },
                { ["name"] = "⚖️ Cân nặng", ["value"] = "`" .. petData.Weight .. "`", ["inline"] = true },
                { ["name"] = "💰 Giá trị", ["value"] = "`" .. petData.Value .. "`", ["inline"] = true },
                { ["name"] = "🗺️ Khu vực", ["value"] = "`" .. petData.Area .. "`", ["inline"] = true },
                { ["name"] = "👤 Nhân vật Roblox", ["value"] = string.format("[%s (@%s)](%s)\n**ID:** `%s`", displayName, playerName, profileLink, userId), ["inline"] = false }
            },
            ["footer"] = { ["text"] = "Throw Food For Animals • Auto Logger" },
            ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    pcall(function()
        httpRequest({
            Url = WebhookURL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload)
        })
    end)
end

