-- ==========================================
-- BẢNG HẬU TỐ SỐ LỚN SIÊU MỞ RỘNG (K -> Spd -> Nod -> Vg -> Hằng hà sa số)
-- ==========================================
local Suffixes = {
    "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", 
    "Dc", "Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", 
    "Vg", "Uvg", "Dvg", "Tvg", "Qavg", "Qivg", "Sxvg", "Spvg", "Ocvg", "Novg", 
    "Tg", "Utg", "Dtg", "Ttg", "Qatg", "Qitg", "Sxtg", "Sptg", "Octg", "Notg", 
    "Qag", "Uqag", "Dqag", "Tqag", "Qaqag", "Qiqag", "Sxag", "Spag", "Ocag", "Noag", "Tg"
}

local function formatBigNumber(val)
    -- Nếu game trả về sẵn chuỗi có chữ (VD: "2,18spd/s", "5.4nod/s") thì giữ nguyên
    if type(val) == "string" then
        if string.find(val, "e%+") or tonumber(val) then
            -- Nếu lỡ là chuỗi dạng số khoa học thì cho qua hàm số học bên dưới
            val = tonumber(val)
        else
            return val
        end
    end

    local num = tonumber(val)
    if not num then return "Không rõ" end
    if num < 1000 then
        return string.format("%.2f", num):gsub("%.00$", "")
    end

    local tier = math.floor(math.log10(math.abs(num)) / 3)
    local suffix = Suffixes[tier + 1]
    if suffix then
        local scaled = num / (10 ^ (tier * 3))
        local formatted = string.format("%.2f", scaled):gsub("%.", ",")
        return formatted .. suffix:lower()
    else
        -- Trường hợp vượt qua cả bảng danh sách trên thì hiển thị dạng khoa học chuẩn
        return string.format("%.2e", num)
    end
end

