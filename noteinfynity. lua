end)

-- Bật / Tắt hiển thị chữ ra màn hình
ToggleShowBtn.MouseButton1Click:Connect(function()
	isShowing = not isShowing
	DisplayContainer.Visible = isShowing
	if isShowing then
		if InputBox.Text ~= "" then
			DisplayLabel.Text = InputBox.Text
		end
		ToggleShowBtn.Text = "🙈 Ẩn khỏi màn hình"
		ToggleShowBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 90)
	else
		ToggleShowBtn.Text = "👁️ Hiển thị lên màn hình"
		ToggleShowBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
	end
end)

-- Xóa chữ
ClearBtn.MouseButton1Click:Connect(function()
	InputBox.Text = ""
	DisplayLabel.Text = ""
end)

-- Tăng / Giảm kích thước chữ
