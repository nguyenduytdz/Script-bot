	ColorBtn.TextColor3 = colors[colorIdx].Val
end)

-- Đổi Hiệu ứng
EffectBtn.MouseButton1Click:Connect(function()
	effectIdx = (effectIdx % #effects) + 1
	local currentEffect = effects[effectIdx]
	EffectBtn.Text = "✨ Hiệu ứng: " .. currentEffect

	DisplayLabel.TextTransparency = 0
	TextStroke.Color = Color3.fromRGB(0, 0, 0)
	TextStroke.Thickness = 2
	DisplayLabel.TextColor3 = colors[colorIdx].Val

	if currentEffect == "Phát sáng (Neon)" then
		TextStroke.Color = colors[colorIdx].Val
		TextStroke.Thickness = 3.5
		DisplayLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end)

-- Bật/Tắt nền mờ sau chữ giúp dễ đọc hơn
BgToggleBtn.MouseButton1Click:Connect(function()
	hasBg = not hasBg
	if hasBg then
		DisplayContainer.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
		DisplayContainer.BackgroundTransparency = 0.35
		if not DisplayContainer:FindFirstChild("UICorner") then
			Instance.new("UICorner", DisplayContainer).CornerRadius = UDim.new(0, 10)
		end
		BgToggleBtn.Text = "⬛ Nền chữ: Bật (Dễ đọc)"
	else
		DisplayContainer.BackgroundTransparency = 1
		BgToggleBtn.Text = "⬛ Nền chữ: Tắt (Bấm để bật)"
	end
end)

-- Đóng / Mở bảng điều khiển
