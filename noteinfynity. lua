	{Name = "Creepster", Enum = Enum.Font.Creepster},
	{Name = "LuckiestGuy", Enum = Enum.Font.LuckiestGuy},
	{Name = "SciFi", Enum = Enum.Font.SciFi}
}
local fontIdx = 1

local colors = {
	{Name = "Trắng", Val = Color3.fromRGB(255, 255, 255)},
	{Name = "Vàng Gold", Val = Color3.fromRGB(255, 215, 0)},
	{Name = "Xanh Neon", Val = Color3.fromRGB(0, 255, 170)},
	{Name = "Đỏ Rực", Val = Color3.fromRGB(255, 65, 65)},
	{Name = "Xanh Dương", Val = Color3.fromRGB(0, 170, 255)},
	{Name = "Tím Hồng", Val = Color3.fromRGB(220, 100, 255)}
}
local colorIdx = 1

local effects = {"Không", "Cầu vồng (RGB)", "Nhấp nháy (Pulse)", "Phát sáng (Neon)", "Lơ lửng (Float)"}
local effectIdx = 1

InputBox:GetPropertyChangedSignal("Text"):Connect(function()
	DisplayLabel.Text = (InputBox.Text == "") and "Ghi chú trống..." or InputBox.Text
	local bounds = DisplayLabel.TextBounds
	DisplayContainer.Size = UDim2.new(0, math.clamp(bounds.X + 32, 140, 480), 0, math.max(bounds.Y + 20, 48))
end)

ToggleShowBtn.MouseButton1Click:Connect(function()
	isShowing = not isShowing
	DisplayContainer.Visible = isShowing
	if isShowing then
		if InputBox.Text ~= "" then
			DisplayLabel.Text = InputBox.Text
		end
		ToggleShowBtn.Text = "Đang hiển thị"
		ToggleShowBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 90)
	else
		ToggleShowBtn.Text = "Hiển thị lên màn hình"
		ToggleShowBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
	end
end)

ClearBtn.MouseButton1Click:Connect(function()
	InputBox.Text = ""
	DisplayLabel.Text = ""
end)

MinusBtn.MouseButton1Click:Connect(function()
	currentSize = math.max(10, currentSize - 2)
	DisplayLabel.TextSize = currentSize
	SizeLabel.Text = "Kích thước: " .. currentSize
end)

PlusBtn.MouseButton1Click:Connect(function()
	currentSize = math.min(72, currentSize + 2)
	DisplayLabel.TextSize = currentSize
	SizeLabel.Text = "Kích thước: " .. currentSize
end)

FontBtn.MouseButton1Click:Connect(function()
	fontIdx = (fontIdx % #fonts) + 1
	DisplayLabel.Font = fonts[fontIdx].Enum
	FontBtn.Text = "Font: " .. fonts[fontIdx].Name
end)

ColorBtn.MouseButton1Click:Connect(function()
	colorIdx = (colorIdx % #colors) + 1
	DisplayLabel.TextColor3 = colors[colorIdx].Val
	ColorBtn.Text = "Màu chữ: " .. colors[colorIdx].Name
	ColorBtn.TextColor3 = colors[colorIdx].Val
end)

EffectBtn.MouseButton1Click:Connect(function()
	effectIdx = (effectIdx % #effects) + 1
	local currentEffect = effects[effectIdx]
	EffectBtn.Text = "Hiệu ứng: " .. currentEffect

	DisplayLabel.TextTransparency = 0
	TextStroke.Color = Color3.fromRGB(0, 0, 0)
	TextStroke.Thickness = 2
	DisplayLabel.TextColor3 = colors[colorIdx].Val

	if currentEffect == "Phát sáng (Neon)" then
		TextStroke.Color = colors[colorIdx].Val
		TextStroke.Thickness = 3.5
		DisplayLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end)

BgToggleBtn.MouseButton1Click:Connect(function()
	hasBg = not hasBg
	if hasBg then
		DisplayContainer.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
		DisplayContainer.BackgroundTransparency = 0.35
		if not DisplayContainer:FindFirstChild("UICorner") then
			Instance.new("UICorner", DisplayContainer).CornerRadius = UDim.new(0, 10)
		end
		BgToggleBtn.Text = "Nền chữ: Bật"
	else
		DisplayContainer.BackgroundTransparency = 1
		BgToggleBtn.Text = "Nền chữ: Tắt"
	end
end)

CloseBtn.MouseButton1Click:Connect(function()
	MainFrame.Visible = false
end)

ToggleBtn.MouseButton1Click:Connect(function()
	MainFrame.Visible = not MainFrame.Visible
end)

local tickCount = 0
RunService.RenderStepped:Connect(function(dt)
	if not isShowing then return end
	tickCount = tickCount + dt
	local currentEffect = effects[effectIdx]

	if currentEffect == "Cầu vồng (RGB)" then
		local hue = (tick() * 0.25) % 1
		DisplayLabel.TextColor3 = Color3.fromHSV(hue, 0.85, 1)
	elseif currentEffect == "Nhấp nháy (Pulse)" then
		local alpha = (math.sin(tickCount * 4) + 1) / 2
		DisplayLabel.TextTransparency = alpha * 0.65
	elseif currentEffect == "Lơ lửng (Float)" then
		local offset = math.sin(tickCount * 3) * 6
		DisplayLabel.Position = UDim2.new(0, 0, 0, offset)
	else
		DisplayLabel.Position = UDim2.new(0, 0, 0, 0)
	end
end)
