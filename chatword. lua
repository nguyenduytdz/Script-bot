local function updateReactionsUI(msgId)
    local data = MessagesData[msgId]
    if not data or not data.reactionLabel then return end

    local counts = {}
    for _, emoji in pairs(data.reactions) do
        if emoji then
            counts[emoji] = (counts[emoji] or 0) + 1
        end
    end

    local parts = {}
    for emoji, count in pairs(counts) do
        table.insert(parts, count > 1 and (emoji .. " " .. count) or emoji)
    end

    if #parts > 0 then
        data.reactionLabel.Text = table.concat(parts, "  ")
        data.reactionFrame.Visible = true
    else
        data.reactionFrame.Visible = false
    end
end

local function applyReactionData(msgId, reactorUserId, emoji)
    local data = MessagesData[msgId]
    if not data then return end

    if data.reactions[reactorUserId] == emoji then
        data.reactions[reactorUserId] = nil
    else
        data.reactions[reactorUserId] = emoji
    end
    updateReactionsUI(msgId)
end

