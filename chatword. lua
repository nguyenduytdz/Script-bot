    RPad.PaddingRight = UDim.new(0, 6)
    RPad.Parent = ReactionFrame

    local ReactionLabel = Instance.new("TextLabel")
    ReactionLabel.Size = UDim2.new(0, 0, 1, 0)
    ReactionLabel.AutomaticSize = Enum.AutomaticSize.X
    ReactionLabel.BackgroundTransparency = 1
    ReactionLabel.Text = ""
    ReactionLabel.TextSize = 12
    ReactionLabel.Parent = ReactionFrame

    MessagesData[msgId] = {
        senderName = senderName,
        text = text,
        reactions = {},
        reactionFrame = ReactionFrame,
        reactionLabel = ReactionLabel
    }

    ReplyActionBtn.MouseButton1Click:Connect(function()
        setReplyTarget(msgId)
    end)

    ReactActionBtn.MouseButton1Click:Connect(function()
        TargetReactionMsgId = msgId
        local btnPos = ReactActionBtn.AbsolutePosition
        local mainPos = MainFrame.AbsolutePosition
        local relY = math.clamp(btnPos.Y - mainPos.Y - 40, 50, MainFrame.AbsoluteSize.Y - 95)
        local relX = isMine and (MainFrame.AbsoluteSize.X - 205) or 35
        ReactionPicker.Position = UDim2.new(0, relX, 0, relY)
        ReactionPicker.Visible = not ReactionPicker.Visible
    end)

    task.defer(function()
        ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.AbsoluteCanvasSize.Y + 500)
    end)

    if not MainFrame.Visible and not isMine then
        UnreadBadge.Visible = true
    end
end

local function sendCurrentMessage()
    local text = MsgInput.Text
    if string.gsub(text, "%s+", "") == "" then return end

    local msgId = tostring(LocalPlayer.UserId) .. "_" .. tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
    local replyId = CurrentReplyId or ""

    MsgInput.Text = ""
    clearReplyTarget()
    ReactionPicker.Visible = false

    pushPacketToNetwork({
        kind = "message",
        id = msgId,
        userId = LocalPlayer.UserId,
        displayName = LocalPlayer.DisplayName,
        username = LocalPlayer.Name,
        text = text,
        replyToId = replyId
    })
end

SendBtn.MouseButton1Click:Connect(sendCurrentMessage)
MsgInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        sendCurrentMessage()
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    if MainFrame.Visible then
        UnreadBadge.Visible = false
    else
        ReactionPicker.Visible = false
    end
end)

MinimizeBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    ReactionPicker.Visible = false
end)

-- Vòng lặp đồng bộ xuyên server
task.spawn(function()
    while ScreenGui.Parent do
        local data = pullUpdatesFromNetwork()
        if data then
            if type(data.messages) == "table" then
                for _, m in ipairs(data.messages) do
                    createMessageBubble(m)
                end
            end
            if type(data.reactions) == "table" then
                for _, r in pairs(data.reactions) do
                    if r and r.msgId and r.userId then
                        applyReactionData(r.msgId, tonumber(r.userId), r.emoji)
                    end
                end
            end
        end
        task.wait(CONFIG.PollInterval)
    end
end)