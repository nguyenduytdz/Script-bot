-- Hàm lấy request function tương thích đa executor
local function getHttpRequest()
    return (syn and syn.request)
        or (http and http.request)
        or http_request
        or request
end

-- Lấy giờ Việt Nam (UTC+7)
local function getVNTime()
    local utc = os.time(os.date("!*t"))
    local vn = os.date("*t", utc + 7 * 3600)
    return string.format("%02d:%02d", vn.hour, vn.min)
end

-- Lấy Avatar Roblox
local function getPlayerAvatar(userId)
    if AvatarCache[userId] then
        return AvatarCache[userId]
    end
    local ok, url = pcall(function()
        return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
    end)
    local result = (ok and url) or "rbxassetid://0"
    AvatarCache[userId] = result
    return result
end

-- Gửi payload lên server trung gian (hoặc lưu local fallback)
local function pushPacketToNetwork(payloadTable)
    payloadTable.room = CONFIG.RoomId
    payloadTable.timestamp = os.time()
    payloadTable.timeStr = getVNTime()

    if CONFIG.Endpoint == "" then
        if payloadTable.kind == "message" then
            table.insert(LocalSharedStore.messages, payloadTable)
        elseif payloadTable.kind == "reaction" then
            LocalSharedStore.reactions[payloadTable.msgId .. "_" .. payloadTable.userId] = payloadTable
        end
        return true
    end

    local reqFn = getHttpRequest()
    if not reqFn then return false end

    local ok = pcall(function()
        reqFn({
            Url = CONFIG.Endpoint,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(payloadTable)
        })
    end)
    return ok
end

-- Kéo dữ liệu mới từ server trung gian
local function pullUpdatesFromNetwork()
    if CONFIG.Endpoint == "" then
        return {
            messages = LocalSharedStore.messages,
            reactions = LocalSharedStore.reactions
        }
    end

    local reqFn = getHttpRequest()
    if not reqFn then return nil end

    local resultData = nil
    local ok = pcall(function()
        local sep = string.find(CONFIG.Endpoint, "?", 1, true) and "&" or "?"
        local url = CONFIG.Endpoint .. sep .. "room=" .. HttpService:UrlEncode(CONFIG.RoomId)
        local res = reqFn({
            Url = url,
            Method = "GET"
        })
        if res and res.Body and res.Body ~= "" then
            resultData = HttpService:JSONDecode(res.Body)
        end
    end)

    return ok and resultData or nil
end

